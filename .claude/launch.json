{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": ["-NoProfile", "-Command", "Set-Location backend; .\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "backend-demo",
      "runtimeExecutable": "powershell.exe",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:KINGUARD_DEV_OPEN='1'; Set-Location backend; .\\.venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
