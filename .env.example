# Copy this file to .env (same folder) and fill in the values. .env is ignored by git.

# Jev decision model (TypeSafe). Used by the gate.
TYPESAFE_API_KEY=
ENABLE_JEV=0

# Gemini. Used for garbled merchant names and for wording the warning.
GEMINI_API_KEY=
ENABLE_GEMINI=0
# GEMINI_MODEL=gemini-3.5-flash-lite

# Look up domain registration dates for real (RDAP).
KINGUARD_LIVE_LOOKUPS=0

# A separately served front end lists its address here (comma separated). Leave empty for same-origin only.
CORS_ORIGINS=
