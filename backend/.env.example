# Copy this file to .env (same folder) and fill in the values. .env is ignored by git.

# Jev decision model (TypeSafe). Used by the gate.
TYPESAFE_API_KEY=
ENABLE_JEV=0

# Gemini. Used for garbled merchant names and for wording the warning.
GEMINI_API_KEY=
ENABLE_GEMINI=0
# GEMINI_MODEL=gemini-3.5-flash-lite

# Look up domain registration dates for real (RDAP).
KINGUARD_LIVE_LOOKUPS=0

# A separately served front end lists its address here (comma separated). Leave empty for same-origin only.
CORS_ORIGINS=

# Live inbox. A mailbox created for KinGuard that the person's own mailbox forwards to.
# Use an app password, not the account password. Leave IMAP_HOST empty to switch it off.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=15

# The caregiver's WhatsApp number in international format, digits only, for example 27821234567.
# Used only to build the wa.me link in /api/guardian/briefs. Leave empty to let the sender pick the contact.
GUARDIAN_WHATSAPP=
# Twilio incoming WhatsApp webhook. The auth token is required outside development mode.
TWILIO_AUTH_TOKEN=
# Public scheme and host Twilio calls, for example https://example.com (needed behind a proxy).
TWILIO_PUBLIC_ORIGIN=
# Set to 0 if the protected person has no caregiver.
KINGUARD_GUARDIAN=1

# Sign-in, and the background scan of the protected person's Gmail. Leave empty to switch both off.
CLERK_SECRET_KEY=
SCAN_SECONDS=60
# The SQLite file for people, invites and mailboxes. Default: backend/kinguard.db
# KINGUARD_DB=
# Development only: 1 skips sign-in (the plain console and local scripts). Never on a reachable server.
KINGUARD_DEV_OPEN=0
